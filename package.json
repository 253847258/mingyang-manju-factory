{
  "name": "mingyang-manju-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "铭扬漫剧自动化工厂：明星演员宫格矩阵定妆 + 小说工坊 + 剧本/分镜工厂，本地零依赖运行",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "offline": "node scripts/start-offline.mjs",
    "enable-offline": "node scripts/enable-offline-png-config.mjs --mock-llm",
    "local-image": "node scripts/local-image-service.js",
    "dev": "node --watch server.js",
    "check": "node tests/selfcheck.js",
    "check:secrets": "node scripts/check-secrets.mjs",
    "data:prune": "node scripts/prune-data.mjs",
    "test": "node scripts/run-tests.mjs --fast",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "test:ui": "node tests/ui-novel-smoke.mjs",
    "test:full": "node scripts/run-tests.mjs --full"
  },
  "author": {
    "name": "林胜",
    "tel": "18850293216"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "ai",
    "comic",
    "drama",
    "novel",
    "storyboard",
    "character"
  ],
  "license": "MIT"
